{
  "name": "@stockin/server",
  "version": "1.2.1",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "scripts": {
    "build": "vite build && vite build --config vite.worker.config.mts",
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@hono/zod-validator": "^0.9.1",
    "@stockin/domain": "workspace:*",
    "@stockin/shared": "workspace:*",
    "exceljs": "^4",
    "hono": "^4",
    "pino": "^9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
