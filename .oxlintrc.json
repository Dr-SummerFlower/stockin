{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-throw-literal": "error",
    "import/no-duplicates": "warn",
    // SQLite 内部伪列名固定为 __rowid，无法改名；只允许这一个标识符。
    "no-underscore-dangle": ["warn", { "allow": ["__rowid"] }]
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-tsc/**",
    "**/node_modules/**",
    "**/.tmp/**",
    "**/*.d.ts"
  ]
}
