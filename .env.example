# 进货统计应用 —— Docker Compose 部署环境变量模板
#
# 用法：复制为 .env 并填入真实值，然后 docker compose up -d --build
#   cp .env.example .env
#   # 编辑 .env，把 PUBLIC_ORIGIN 改成服务器实际访问地址
#
# .env 已被 .gitignore 与 .dockerignore 排除，不会进仓库、不会进镜像。

# 【必填】主可信来源：必须是 http://<服务器IP或主机名>:<宿主端口>。
# 端口必须与 HOST_PORT / 容器 PORT(8080) 一致，否则启动即 fail-fast。
PUBLIC_ORIGIN=http://192.168.1.100:8080

# 【可选】逗号分隔的多个可信来源；一旦设置即覆盖 PUBLIC_ORIGIN。
# 如需同时用服务器IP、本机 127.0.0.1、localhost 登录，取消注释并改成你的地址。
# 回环写法（127.0.0.1 / localhost / [::1]）会自动等价展开，故也可只写其一。
# PUBLIC_ORIGINS=http://192.168.1.100:8080,http://127.0.0.1:8080,http://localhost:8080

# 【可选】宿主机映射端口，默认 8080。若修改，必须同步调整 PUBLIC_ORIGIN 的端口。
HOST_PORT=8080

# 【可选】基础镜像，默认 node:26.13.0-bookworm-slim（须与 server 的 Node 版本断言一致）。
# NODE_IMAGE=node:26.13.0-bookworm-slim
