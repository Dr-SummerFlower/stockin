# 进货统计应用 —— Docker Compose 部署环境变量模板
#
# 用法：复制为 .env → 填好来源白名单与镜像版本 → docker compose up -d
#   cp .env.example .env
# .env 已被 .gitignore 与 .dockerignore 排除，不会进仓库、不会进镜像。

# 【必填】镜像仓库（不含标签）。CI 生成的发布包会自动把这里替换成实际仓库，
# fork 或换账号后无需改 docker-compose.yml。
IMAGE_REPO=ghcr.io/dr-summerflower/stockin

# 【必填】镜像版本：GitHub Release 的正式版本号（如 1.0）或预发布标签
# （如 pre）。升级与回滚都只改这一行。
IMAGE_TAG=1.0

# 【来源白名单 · 必看】把所有会用来访问本应用的地址都列进来，逗号分隔。
# 格式必须是 http://<IP或域名>:<宿主端口>，端口必须与 HOST_PORT 一致。
# 漏配任何地址 → 从该地址登录或写数据都会返回「请求来源校验失败」(403)。
# 回环写法（127.0.0.1 / localhost / [::1]）会自动等价展开。
# 部署时把 192.168.1.100 换成服务器实际 IP；有域名就再加 http://<域名>:8080。
# 建议把最常用的地址放首位（它会作为日志里的主来源）。
PUBLIC_ORIGINS=http://192.168.1.100:8080,http://127.0.0.1:8080,http://localhost:8080

# 【可选】单值写法。PUBLIC_ORIGINS 一旦设置即以此为准，本项仅作兼容保留；
# 不打算用多来源时，删掉上面的 PUBLIC_ORIGINS 再用这一行即可。
PUBLIC_ORIGIN=http://192.168.1.100:8080

# 【可选】额外域名或 IP，供 start.sh / start.bat 自动生成白名单时追加。
# EXTRA_ORIGINS=http://stockin.example.com:8080

# 【可选】宿主机映射端口，默认 8080。若修改，必须同步调整上面所有来源的端口。
HOST_PORT=8080

# 【管理员入口 · 可选】独立系统维护身份（GitHub OAuth 登录），与店主账号无关。
# 创建一个 GitHub OAuth App，回调地址填 <入口>/api/admin/auth/github/callback，
# 把 client id/secret 与允许登录的账号名填在下面。三项缺一即禁用管理员入口。
# 启用后访问 /admin/login；所有维护操作写入安全审计日志。详见 README「管理员入口」。
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 备份默认公钥（P-256 SPKI/DER base64，单行）；`pnpm backup:keygen` 生成到本地 .keys/。
# 只在首次启动、库内没有任何公钥时播种一条默认公钥；此后加密与验签只读库内，
# 轮换/增删全在管理台「备份公钥」里做，本项不再参与运行期逻辑。
# 私钥只留 .keys/，不要写进 .env 或镜像。
# BACKUP_PUBLIC_KEY=
# ADMIN_GITHUB_LOGINS=alice,bob
